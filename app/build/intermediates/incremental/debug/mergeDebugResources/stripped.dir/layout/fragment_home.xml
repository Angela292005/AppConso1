<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/light_bg_celeste"
    tools:context=".ui.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Card Contenedor Principal -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Título Bienvenido a RUTAS -->
                <TextView
                    android:id="@+id/tvWelcomeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_welcome_title"
                    android:textColor="@color/primary_dark_blue"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center_horizontal" />

                <TextView
                    android:id="@+id/tvWelcomeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_welcome_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center_horizontal" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/divider_color" />

                <!-- EditText para el nombre del colaborador -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNombreColaborador"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/home_input_hint"
                    app:boxStrokeColor="@color/primary_dark_blue"
                    app:hintTextColor="@color/primary_dark_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreColaborador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón 1: Enviar Notificación Saludo -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotificacionSaludo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:paddingVertical="12dp"
                    android:text="@string/btn_notify_welcome"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/primary_dark_blue"
                    app:cornerRadius="8dp" />

                <!-- Botón 2: Registrar Actividad -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingVertical="12dp"
                    android:text="@string/btn_register_activity"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/accent_celeste"
                    app:cornerRadius="8dp" />

                <!-- Botón 3: Ver mi perfil -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerPerfil"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingVertical="12dp"
                    android:text="@string/btn_view_profile"
                    android:textColor="@color/primary_dark_blue"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/primary_dark_blue"
                    app:strokeWidth="2dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
