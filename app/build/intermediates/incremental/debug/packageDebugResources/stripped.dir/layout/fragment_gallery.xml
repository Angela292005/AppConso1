<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/light_bg_celeste"
    tools:context=".ui.gallery.GalleryFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Avatar Icon -->
                <ImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/ic_menu_profile"
                    android:contentDescription="@string/profile_title"
                    app:tint="@color/primary_dark_blue" />

                <!-- Título Ficha de Perfil -->
                <TextView
                    android:id="@+id/tvProfileTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/profile_title"
                    android:textColor="@color/primary_dark_blue"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center_horizontal" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/divider_color" />

                <!-- TextView Nombre -->
                <TextView
                    android:id="@+id/tvNombreColaborador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre: No especificado"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- TextView Área -->
                <TextView
                    android:id="@+id/tvAreaColaborador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Área: Operaciones y Logística"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <!-- TextView Años de Experiencia -->
                <TextView
                    android:id="@+id/tvExpColaborador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Años de Experiencia: 3 años"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <!-- Botón Buscar en Google (Intent Implícito) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuscarGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingVertical="12dp"
                    android:text="@string/btn_search_google"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/accent_celeste"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_menu_home" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
