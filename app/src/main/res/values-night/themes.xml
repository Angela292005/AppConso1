<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme para Modo Noche / Oscuro. -->
    <style name="Theme.RojasQuispeAngelaDeniss" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_dark_blue</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_celeste</item>
        <item name="colorSecondaryVariant">@color/accent_celeste</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.RojasQuispeAngelaDeniss.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.RojasQuispeAngelaDeniss.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.RojasQuispeAngelaDeniss.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />
</resources>
